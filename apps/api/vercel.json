{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --include=dev --no-audit --no-fund",
  "buildCommand": "npx prisma generate && npx prisma migrate deploy && npx nest build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist,prisma,assets}/**",
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/ops/cron/daily",
      "schedule": "0 3 * * *"
    }
  ]
}
