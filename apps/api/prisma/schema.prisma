generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Workspace - Team/Organization
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Gemini key for this workspace, encrypted with APP_SECRET (AES-256-GCM)
  geminiKeyEnc String? @map("gemini_key_enc")
  // Free AI write-ups on the shared key, counted per calendar month
  aiUsed       Int      @default(0) @map("ai_used")
  aiPeriod     String?  @map("ai_period") // "2026-11"
  githubRepo   String?  @map("github_repo") // "owner/name"
  isDemo       Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  bugReports BugReport[]
  apiKeys    ApiKey[]
  projects   Project[]
  members    Membership[]
  invites    Invite[]
  integrations Integration[]

  @@map("workspaces")
}

// User account
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  avatarUrl   String?  @map("avatar_url")
  workspaceId String   @map("workspace_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions   Session[]
  bugReports BugReport[]
  authTokens AuthToken[]
  apiKeys    ApiKey[]
  assigned   BugReport[] @relation("assigned")
  comments   Comment[]
  activity   Activity[]
  memberships Membership[]
  invitesSent Invite[]   @relation("invitedBy")
  // Email me when I am assigned or mentioned
  notifyEmail Boolean    @default(true) @map("notify_email")

  @@map("users")
}

// One-time email login code (only the hash is stored)
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("login_codes")
}

// Sign-in token for the dashboard or the extension (only the hash is stored)
model AuthToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  client     String   @default("web") // web | extension
  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

// Recording session
model Session {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  status    SessionStatus @default(RECORDING)
  metadata  Json?         // Browser info, OS, viewport size, etc.
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recording Recording?
  logs      SessionLog[]
  bugReport BugReport?

  @@map("sessions")
}

enum SessionStatus {
  RECORDING
  PROCESSING
  COMPLETED
  FAILED
}

// Video recording
model Recording {
  id          String   @id @default(cuid())
  sessionId   String   @unique @map("session_id")
  url         String?  // URL to stored video (S3/R2)
  duration    Int?     // Duration in seconds
  size        Int?     // File size in bytes
  mimeType    String?  @default("video/webm") @map("mime_type")
  thumbnailUrl String? @map("thumbnail_url")
  createdAt   DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("recordings")
}

// Session logs (console, network, clicks, errors)
model SessionLog {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  type      LogType
  level     LogLevel @default(INFO)
  message   String
  data      Json?    // Additional data (stack trace, request/response, element info)
  timestamp DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, type])
  @@index([sessionId, timestamp])
  @@map("session_logs")
}

enum LogType {
  CONSOLE    // Console.log/warn/error
  NETWORK    // HTTP requests
  CLICK      // User clicks
  ERROR      // JavaScript errors
  NAVIGATION // Page navigations
  INPUT      // Form inputs (sanitized)
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// Bug report generated from session
model BugReport {
  id             String       @id @default(cuid())
  sessionId      String?      @unique @map("session_id")
  workspaceId    String?      @map("workspace_id")
  reporterId     String?      @map("reporter_id")

  // Bug details
  title          String
  description    String?
  stepsToReproduce String[]   @map("steps_to_reproduce")
  expectedResult String?      @map("expected_result")
  actualResult   String?      @map("actual_result")

  // Classification
  severity       Severity     @default(MEDIUM)
  status         ReportStatus @default(OPEN)

  // AI analysis
  aiSummary      String?      @map("ai_summary")
  aiRootCause    String?      @map("ai_root_cause")
  aiSuggestions  String[]     @map("ai_suggestions")

  // Triage
  number         Int?         // BUG-<number>, per workspace
  priority       String       @default("none") // urgent | high | medium | low | none
  labels         String[]     @default([])
  assigneeId     String?      @map("assignee_id")
  projectId      String?      @map("project_id")

  // Sharing, duplicates and AI state
  shareToken     String?      @unique @map("share_token")
  errorSignature String?      @map("error_signature")
  aiStatus       String?      @map("ai_status") // done | failed | skipped

  // Metadata
  url            String?      // URL where bug occurred
  browserInfo    Json?        @map("browser_info")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  session   Session?   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reporter  User?      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  assignee  User?      @relation("assigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments  Comment[]
  activity  Activity[]
  links     ReportLink[]

  @@unique([workspaceId, number])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, errorSignature])
  @@index([workspaceId, status])
  @@index([workspaceId, severity])
  @@index([reporterId])
  @@map("bug_reports")
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  FIX_READY
  RESOLVED
  CLOSED
  WONT_FIX
}

// Personal API key for coding agents (MCP) and scripts. Only the hash is stored.
model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  name        String
  prefix      String    // first characters, shown in the UI
  keyHash     String    @unique @map("key_hash")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_keys")
}

// A website or app inside a workspace. Reports are matched by URL host.
model Project {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  color       String   @default("#3B82F6")
  hosts       String[] @default([]) // e.g. shop.acme.com, localhost:3000
  // Website widget: public key used in the <script> tag
  widgetKey     String?  @unique @map("widget_key")
  widgetEnabled Boolean  @default(false) @map("widget_enabled")
  widgetConfig  Json?    @map("widget_config") // { label, position, color }
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reports   BugReport[]

  @@index([workspaceId])
  @@map("projects")
}

model Comment {
  id        String   @id @default(cuid())
  reportId  String   @map("report_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  report BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("comments")
}

// What happened to a report, newest last. actorId null = BugSnap itself.
model Activity {
  id        String   @id @default(cuid())
  reportId  String   @map("report_id")
  actorId   String?  @map("actor_id")
  kind      String   // created | ai_done | ai_failed | status | assignee | priority | labels | project | shared | title
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  report BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@map("activity")
}

// A person's place in a workspace. user.workspaceId is just the one they use right now.
model Membership {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        String   @default("member") // owner | admin | member | guest
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

// Email invite to join a workspace. Only the token hash is stored.
model Invite {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  email       String
  role        String    @default("member")
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("invitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@map("invites")
}

// A connected tool (GitHub, Linear, Jira, Slack) for one workspace.
model Integration {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  provider    String   // github | linear | jira | slack
  // Non-secret settings (installation id, default repo/team/project, account name)
  config      Json     @default("{}")
  // Secrets (API tokens, webhook URLs), encrypted with APP_SECRET
  secretEnc   String?  @map("secret_enc")
  // For incoming webhooks (Linear) we look integrations up by this id
  externalId  String?  @map("external_id")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([provider, externalId])
  @@map("integrations")
}

// A bug report linked to an issue in another tool.
model ReportLink {
  id         String   @id @default(cuid())
  reportId   String   @map("report_id")
  provider   String   // github | linear | jira
  externalId String   @map("external_id") // e.g. "owner/repo#12", Linear issue id, Jira key
  key        String   // what people read: "acme/web#12", "ENG-42", "PAY-7"
  url        String
  state      String?  // open | closed | the tool's own state name
  createdAt  DateTime @default(now()) @map("created_at")

  report BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([reportId])
  @@map("report_links")
}
