# Postgres. DIRECT_URL is used for migrations (same as DATABASE_URL locally).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_bug_recorder
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ai_bug_recorder

PORT=3001
BASE_URL=http://localhost:3001
# Comma-separated list of dashboard origins allowed to call the API
FRONTEND_URL=http://localhost:3002

# Encrypts saved Gemini keys. Any long random string. Required in production.
APP_SECRET=change-me

# Optional: a shared Gemini key used when a workspace has not saved its own
GEMINI_API_KEY=
# Tried in order when one is busy
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest
# Free AI write-ups per workspace per month on the shared key
SHARED_AI_MONTHLY_LIMIT=20

# Email for sign-in codes. Leave empty locally: the code is shown on screen instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Production file storage (Vercel Blob). Leave empty locally to use ./uploads.
BLOB_READ_WRITE_TOKEN=

# GitHub App (issues, two-way sync, AI fix pull requests). From the app's settings page.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The .pem contents on one line with \n for newlines
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Team error alerts: comma-separated emails that see /dashboard/ops and get alerts; optional Slack webhook
OPS_EMAILS=
OPS_SLACK_WEBHOOK=
# Secret Vercel Cron sends to /ops/cron/daily (Authorization: Bearer ...)
CRON_SECRET=
# Set to "off" to disable rate limits (local testing only)
RATE_LIMITS=
